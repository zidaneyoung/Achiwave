# Copy this file to .env for local development.
# EXPO_PUBLIC_* values are embedded in the application and are never secret.
EXPO_PUBLIC_API_ENV=development
# Android emulators use 10.0.2.2 for services running on the host.
# Replace this with a reachable LAN URL when using a physical device.
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
