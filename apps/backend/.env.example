# Copy this file to .env for local development. Keep real credentials out of Git.
ACHIWAVE_APP_ENVIRONMENT=development
ACHIWAVE_HOST=127.0.0.1
ACHIWAVE_PORT=8000
ACHIWAVE_LOG_LEVEL=INFO
ACHIWAVE_SERVICE_NAME=backend
ACHIWAVE_DATABASE_URL=postgresql+psycopg://achiwave:replace-with-local-password@localhost:5432/achiwave
ACHIWAVE_REDIS_URL=redis://localhost:6379/0
ACHIWAVE_CELERY_BROKER_URL=redis://localhost:6379/0
ACHIWAVE_CELERY_RESULT_BACKEND=redis://localhost:6379/0
ACHIWAVE_ACCESS_TOKEN_SIGNING_KEY=replace-with-at-least-32-random-characters
ACHIWAVE_ACCESS_TOKEN_ALGORITHM=HS256
ACHIWAVE_ACCESS_TOKEN_ISSUER=achiwave
ACHIWAVE_ACCESS_TOKEN_AUDIENCE=achiwave-mobile
ACHIWAVE_ACCESS_TOKEN_LIFETIME_SECONDS=900
ACHIWAVE_REFRESH_TOKEN_LIFETIME_SECONDS=2592000
ACHIWAVE_PASSWORD_MIN_LENGTH=12
ACHIWAVE_PASSWORD_MAX_LENGTH=128
